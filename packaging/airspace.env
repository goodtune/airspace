# Airspace settings. This file holds a secret: keep it readable by root only.
# Every setting is described in the README:
# https://github.com/goodtune/airspace#configuration

# Required: an OpenSky API client, from your OpenSky account page.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

#LISTEN_ADDR=:8080
#POLL_INTERVAL=10s
#MAX_DB_SIZE=2GB
#RETENTION_DAYS=30

# HTTPS with a certificate from an ACME server. Also uncomment the two
# capability lines in the unit: systemctl edit airspace.service
#ACME_DOMAINS=airspace.example.org
#ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# Metrics over OTLP.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://collector.example.org:4318
